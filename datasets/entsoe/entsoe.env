# Copy this file to entsoe.env and fill in your own key.
#   cp datasets/entsoe/entsoe.env.example datasets/entsoe/entsoe.env
#
# entsoe.env is gitignored so the key is never committed. The app container
# reads it via docker-compose (env_file), and local `streamlit run` reads it
# directly as a fallback. Get a key from https://transparency.entsoe.eu/
# (register, then request API access under My Account Settings).
ENTSOE_API_KEY=ed35717a-695d-4e29-9ace-a99d5e5369dc
